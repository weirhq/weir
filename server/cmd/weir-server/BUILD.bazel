load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "weir-server_lib",
    srcs = [
        "main.go",
        "webui_embed.go",
        "webui_none.go",
    ],
    importpath = "github.com/weirhq/weir/server/cmd/weir-server",
    visibility = ["//visibility:private"],
    deps = [
        "//proto/weir/api/v1alpha",
        "//server/internal/admin",
        "//server/internal/artwork",
        "//server/internal/auth",
        "//server/internal/browse",
        "//server/internal/config",
        "//server/internal/engine",
        "//server/internal/jobs",
        "//server/internal/library",
        "//server/internal/media",
        "//server/internal/metadata",
        "//server/internal/playback",
        "//server/internal/store",
        "//server/internal/web",
        "//server/internal/web/dist",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_riverqueue_river//:river",
    ],
)

go_binary(
    name = "weir-server",
    embed = [":weir-server_lib"],
    # Embed the web client (webui_embed.go).
    gotags = ["webembed"],  # keep
    visibility = ["//visibility:public"],
)
