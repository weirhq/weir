root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.rs]
indent_size = 4

[{BUILD.bazel,*.bzl,MODULE.bazel}]
indent_size = 4

[Makefile]
indent_style = tab

# Vendored files stay exactly as published.
[web/ui/{src/fonts,tokens/androidx}/**]
trim_trailing_whitespace = false
insert_final_newline = false
