load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "engine",
    srcs = ["supervisor.go"],
    importpath = "github.com/weirhq/weir/server/internal/engine",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//proto/weir/engine/v1alpha",
        "//server/internal/version",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_test(
    name = "engine_test",
    srcs = ["supervisor_test.go"],
    embed = [":engine"],
    deps = [
        "//proto/weir/engine/v1alpha",
        "@org_golang_google_grpc//:grpc",
    ],
)
