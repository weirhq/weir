common --enable_bzlmod
common --lockfile_mode=update

# Opt out of usage reporting by Aspect's rulesets (aspect_tools_telemetry).
common --repo_env=DO_NOT_TRACK=1

# Use protobuf's prebuilt protoc instead of compiling it from source.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

build --incompatible_strict_action_env
build --heap_dump_on_oom

test --test_output=errors

# CI pins the lockfile and fails if it drifts.
common:ci --lockfile_mode=error
build:ci --noshow_progress
build:ci --show_timestamps

try-import %workspace%/user.bazelrc

# Postgres-backed tests skip unless this is set (see `mise run db`).
test --test_env=WEIR_TEST_DATABASE_URL
