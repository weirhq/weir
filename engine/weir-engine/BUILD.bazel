load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "weir_engine",
    srcs = ["src/lib.rs"],
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//engine/crates/probe",
        "//engine/crates/proto:engine_proto",
        "//engine/crates/session",
    ],
)

rust_binary(
    name = "weir-engine",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        ":weir_engine",
        "//engine/crates/session",
    ],
)

rust_test(
    name = "socket_test",
    srcs = ["tests/socket.rs"],
    edition = "2024",
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":weir_engine",
        "//engine/crates/proto:engine_proto",
        "//engine/crates/session",
    ],
)
