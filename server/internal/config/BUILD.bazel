load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    importpath = "github.com/weirhq/weir/server/internal/config",
    visibility = ["//server:__subpackages__"],
    deps = ["@com_github_pelletier_go_toml_v2//:go-toml"],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    embed = [":config"],
)
