# Copy to .env next to compose.yaml and fill in.

# The folder with your films, shows and music. Libraries are made from
# folders inside it, in Settings.
WEIR_MEDIA=/srv/media

# The address people use to reach this server.
WEIR_BASE_URL=http://localhost:8320

# A long random password for the database, e.g. from `openssl rand -hex 24`.
WEIR_DB_PASSWORD=

# Optional.
# WEIR_PORT=8320
# WEIR_TLS_MODE=off
# WEIR_TMDB_API_KEY=
# WEIR_MUSICBRAINZ_CONTACT=
# Pin image versions (they default to the release this file came from):
# WEIR_VERSION=0.1.0
# WEIR_ENGINE_VERSION=0.1.0
