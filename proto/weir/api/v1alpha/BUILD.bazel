load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")

# gazelle:go_grpc_compilers @io_bazel_rules_go//proto:go_proto,//tools/proto:connect_go

proto_library(
    name = "apiv1alpha_proto",
    srcs = [
        "admin.proto",
        "auth.proto",
        "browse.proto",
        "library.proto",
        "playback.proto",
        "user.proto",
    ],
    strip_import_prefix = "/proto",
    visibility = ["//visibility:public"],
    deps = [
        "@protobuf//:field_mask_proto",
        "@protobuf//:timestamp_proto",
    ],
)

buf_lint_test(
    name = "apiv1alpha_proto_lint",
    config = "//proto:buf.yaml",
    targets = [":apiv1alpha_proto"],
)

go_proto_library(
    name = "apiv1alpha_go_proto",
    compilers = [
        "@io_bazel_rules_go//proto:go_proto",
        "//tools/proto:connect_go",
    ],
    importpath = "github.com/weirhq/weir/proto/weir/api/v1alpha",
    proto = ":apiv1alpha_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "v1alpha",
    embed = [":apiv1alpha_go_proto"],
    importpath = "github.com/weirhq/weir/proto/weir/api/v1alpha",
    visibility = ["//visibility:public"],
)

# Read by the web client's protobuf-es generation.
filegroup(
    name = "protos",
    srcs = glob(["*.proto"]),
    visibility = ["//web/app:__pkg__"],
)
