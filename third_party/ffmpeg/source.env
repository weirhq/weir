# Inputs to the ffmpeg build. Bumping any of these and running the "ffmpeg"
# workflow produces a new release to pin (see docs/runbooks/ffmpeg.md).

# Verified against the FFmpeg release signing key
# FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8 when pinned.
FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# Headers only; enables NVENC/NVDEC without linking anything from NVIDIA.
NV_CODEC_HEADERS_VERSION=n13.1.15.0
NV_CODEC_HEADERS_SHA256=2255bc74d038b95aa4be30f5f66322c2176acbdb90ada1851db6993536fbeaf7

# Ubuntu 24.04's are too old for ffmpeg 9 (it needs libplacebo >= 7.351 and
# Vulkan headers >= 1.3.277), so both are built here. libplacebo is a git
# checkout because its release archives omit the submodules it builds with;
# the commit pins those too.
VULKAN_HEADERS_VERSION=v1.4.367
VULKAN_HEADERS_SHA256=0df7d58b5df617e0a6a17dec521af459206719f9c7cb12d05d09275597c16f70
LIBPLACEBO_VERSION=v7.387.0
LIBPLACEBO_COMMIT=275f7dea27924cdd34ab2e6c20e448b6bc4fab65

# Bump when the build changes without a version change (patches, flags).
BUILD_REVISION=1
