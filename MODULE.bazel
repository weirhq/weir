module(name = "weir")

bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_go", version = "0.65.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.75.0")
use_repo(buf, "rules_buf_toolchains")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_connectrpc_connect", "com_github_golang_jwt_jwt_v5", "com_github_google_uuid", "com_github_jackc_pgx_v5", "com_github_pelletier_go_toml_v2", "com_github_pressly_goose_v3", "com_github_riverqueue_river", "com_github_riverqueue_river_riverdriver_riverpgxv5", "com_github_riverqueue_river_rivertype", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_image", "org_golang_x_time")

# Prebuilt sqlc. Building it from source drags in libpg_query through cgo.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

[
    http_archive(
        name = "sqlc_" + platform,
        build_file_content = 'exports_files(["sqlc"])',
        sha256 = sha256,
        url = "https://github.com/sqlc-dev/sqlc/releases/download/v1.31.1/sqlc_1.31.1_%s.tar.gz" % platform,
    )
    for platform, sha256 in {
        "darwin_amd64": "c5af76772e3785d21663a62697056b383f07629979b1bd25b93872e73dbd519b",
        "darwin_arm64": "21602158c99eb1f2bae197a66abfb1941d1e9e50b23125bb193349c6b1acc71e",
        "linux_amd64": "497ae4fcdfa64c5b0c311ffe4c2bd991e43991e82e5367792ed78bc2dca27354",
        "linux_arm64": "b7cae247740d0c51a1e657479e5b2d21e6fef428f596682a01bc55bf4ab8a23d",
    }.items()
]

# Prebuilt protoc for Cargo build scripts (tonic-prost-build). Bazel's own
# proto rules use protobuf's toolchain instead.
[
    http_archive(
        name = "protoc_" + platform,
        build_file_content = """
exports_files(["bin/protoc"])

filegroup(
    name = "include",
    srcs = glob(["include/**/*.proto"]),
    visibility = ["//visibility:public"],
)
""",
        sha256 = sha256,
        url = "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protoc-36.2-%s.zip" % platform.replace("_aarch64", "-aarch_64").replace("_x86_64", "-x86_64"),
    )
    for platform, sha256 in {
        "linux_aarch64": "8b8f18bd2b30346efbc698dd5a73dd7c805f3ef8380f6dfc95c768f3f1852f6a",
        "linux_x86_64": "121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278",
        "osx_aarch64": "9cd98a532c5c5e0c4161314de0225de27e4c8a323917b6ea7b1b714d3ae23466",
        "osx_x86_64": "228cc7add4616cc14ca5e80dee83209d44449a7aee95a914ae748fa374efb078",
    }.items()
]

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//engine:Cargo.lock",
    manifests = [
        "//engine:Cargo.toml",
        "//engine/crates/probe:Cargo.toml",
        "//engine/crates/proto:Cargo.toml",
        "//engine/crates/session:Cargo.toml",
        "//engine/weir-engine:Cargo.toml",
    ],
)
use_repo(crate, "crates")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.22.2")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//web:package.json",
        "//web:patches/@material__material-color-utilities@0.4.0.patch",
        "//web:pnpm-workspace.yaml",
        "//web/app:package.json",
        "//web/ui:package.json",
    ],
    pnpm_lock = "//web:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "//web:package.json")
use_repo(rules_ts_ext, "npm_typescript")

# BEGIN ffmpeg (written by tools/ffmpeg/pin.sh; see docs/runbooks/ffmpeg.md)
http_archive(
    name = "ffmpeg_linux_amd64",
    build_file_content = 'exports_files(["bin/ffmpeg", "bin/ffprobe"])\nfilegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "5c3bd2d98fdc72c9facd6bd55cda2580663829eb6015524074803dda5e6a33bd",
    strip_prefix = "weir-ffmpeg-9.0.2-1-linux-amd64",
    url = "https://github.com/weirhq/weir/releases/download/ffmpeg-9.0.2-1/weir-ffmpeg-9.0.2-1-linux-amd64.tar.gz",
)
http_archive(
    name = "ffmpeg_linux_arm64",
    build_file_content = 'exports_files(["bin/ffmpeg", "bin/ffprobe"])\nfilegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = "521f1448568f82327046f93d8bfbb78f19b244b3bbec1656da8a5a5f3f3c61a5",
    strip_prefix = "weir-ffmpeg-9.0.2-1-linux-arm64",
    url = "https://github.com/weirhq/weir/releases/download/ffmpeg-9.0.2-1/weir-ffmpeg-9.0.2-1-linux-arm64.tar.gz",
)
# END ffmpeg
