load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/weirhq/weir/server/internal/version",
    visibility = ["//server:__subpackages__"],
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    data = [
        "//engine:Cargo.toml",
        "//engine:version.bzl",
    ],
    embed = [":version"],
)
